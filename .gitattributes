# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Source code files
*.js       text eol=lf diff=javascript
*.css      text eol=lf diff=css
*.html     text eol=lf diff=html
*.sql      text eol=lf diff=sql
*.json     text eol=lf

# Documentation
*.md       text eol=lf

# Binary media & assets
*.png      binary
*.jpg      binary
*.jpeg     binary
*.ico      binary
*.svg      text eol=lf
*.woff2    binary
*.mp3      binary
*.wav      binary
